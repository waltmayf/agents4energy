{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "$amplify/*": [
        "../.amplify/generated/*"
      ]
    }
  },
  // Test files (e.g. constructs/*.test.ts) are run by `node --test
  // --experimental-strip-types`, which REQUIRES the `.ts` import extension.
  // The Amplify backend type-check has no `allowImportingTsExtensions`, so it
  // rejects that extension (TS5097). Excluding tests keeps them out of the
  // backend synth type-check while `node --test` still runs them directly.
  //
  // agentcore/ClaudeCode and agentcore/AguiAgent are container build contexts
  // with their own tsconfig/deps (AguiAgent's only exist inside its image) —
  // excluded here for the same TS5097 reason plus missing-deps errors.
  "exclude": [
    "**/*.test.ts",
    "**/*.test.mts",
    "agentcore/ClaudeCode/**",
    "agentcore/AguiAgent/**"
  ]
}