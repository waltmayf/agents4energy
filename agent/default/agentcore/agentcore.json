{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "default",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "default"
  },
  "runtimes": [
    {
      "name": "ClaudeCode",
      "description": "Claude Code CLI hosted in AgentCore Runtime; invoked via @agentcore-claude on GitHub issues/PRs.",
      "build": "Container",
      "codeLocation": "app/ClaudeCode",
      "dockerfile": "Dockerfile",
      "entrypoint": "server.js",
      "protocol": "HTTP",
      "networkMode": "PUBLIC",
      "filesystemConfigurations": [
        {
          "sessionStorage": {
            "mountPath": "/mnt/workspace"
          }
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_MODEL",
          "value": "us.anthropic.claude-sonnet-5"
        }
      ],
      "connections": [
        {
          "id": "browser",
          "to": {
            "type": "browser"
          }
        }
      ]
    },
    {
      "name": "AguiAgent",
      "description": "AG-UI-native AgentCore Runtime (issue #176) — emits AG-UI events directly (no Bedrock Converse translation) and persists turns to MyHarnessMemory.",
      "build": "Container",
      "codeLocation": "app/AguiAgent",
      "dockerfile": "Dockerfile",
      "entrypoint": "server.ts",
      "protocol": "AGUI",
      "networkMode": "PUBLIC",
      "envVars": [
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "us.anthropic.claude-sonnet-5"
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "MyHarnessMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaces": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaces": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "default-gateway",
      "description": "Gateway for default-gateway",
      "targets": [],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_qG5061DTr/.well-known/openid-configuration",
          "allowedClients": [
            "2hugv1ugrni8jts323q1ldiopt"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "DEBUG",
      "policyEngineConfiguration": {
        "policyEngineName": "DefaultCedar",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "DefaultCedar",
      "description": "Cedar policy engine for default-gateway. Associated in LOG_ONLY mode (evaluates and logs decisions without blocking) — tool calls are not yet routed through the gateway (#273), so ENFORCE has no effect yet. No static policies here: the sync-cedar-policies Lambda (#272, web/amplify/functions/sync-cedar-policies) generates and pushes Cedar policies directly via CreatePolicy/UpdatePolicy/DeletePolicy whenever a GroupToolGrant row changes (web/amplify/data/schemas/agentConfig.schema.ts), so this array intentionally stays empty — the live policy set lives on the deployed engine, not in this file.",
      "policies": []
    }
  ],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "harnesses": [
    {
      "name": "MyHarness",
      "path": "app/MyHarness"
    }
  ],
  "datasets": []
}
